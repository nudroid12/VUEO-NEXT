name: VUEO Repo Layout Guard

on:
  workflow_dispatch:
  push:
    branches:
      - main
    paths:
      - "src/**"
      - ".github/workflows/vueo-repo-layout-guard.yml"

permissions:
  contents: write

concurrency:
  group: vueo-repo-layout-guard
  cancel-in-progress: false

env:
  JAVA_VERSION: "17"
  GRADLE_VERSION: "9.3.1"
  ANDROID_API: "36"
  ANDROID_BUILD_TOOLS: "36.0.0"

jobs:
  cleanup-and-verify:
    runs-on: ubuntu-latest
    timeout-minutes: 30

    steps:
      - name: Checkout main
        uses: actions/checkout@v6
        with:
          ref: main
          fetch-depth: 2

      - name: Audit stray root source tree
        shell: bash
        run: |
          set -euo pipefail

          python3 <<'PY'
          from pathlib import Path

          root = Path("src/main")
          if not root.exists():
              print("No stray root src/main tree found.")
              raise SystemExit(0)

          missing = []
          unknown = []

          for path in sorted(p for p in root.rglob("*") if p.is_file()):
              rel = path.relative_to(root)
              parts = rel.parts

              target = None
              if rel.as_posix() == "AndroidManifest.xml":
                  target = Path("tv/src/main/AndroidManifest.xml")
              elif len(parts) >= 4 and parts[:4] == ("java", "com", "vueo", "app"):
                  target = Path("mobile/src/main") / rel
              elif len(parts) >= 4 and parts[:4] == ("java", "com", "vueo", "tv"):
                  target = Path("tv/src/main") / rel
              elif parts and parts[0] == "res":
                  target = Path("tv/src/main") / rel
              else:
                  unknown.append(rel.as_posix())
                  continue

              if not target.is_file():
                  missing.append(f"{rel.as_posix()} -> {target.as_posix()}")

          if unknown or missing:
              if unknown:
                  print("Unknown root files:")
                  for item in unknown:
                      print("  ", item)
              if missing:
                  print("Root files without canonical module counterpart:")
                  for item in missing:
                      print("  ", item)
              raise SystemExit(
                  "Refusing to delete src/main because unique/unmapped files may still exist."
              )

          print("Audit passed: every stray root file has a canonical Mobile/TV counterpart.")
          PY

      - name: Remove stray root source tree
        shell: bash
        run: |
          set -euo pipefail
          if [ -d src ]; then
            rm -rf src
            echo "Removed stray root src/ tree."
          else
            echo "Root src/ already absent."
          fi

      - name: Verify canonical module layout
        shell: bash
        run: |
          set -euo pipefail
          test ! -e src
          test -f mobile/build.gradle.kts
          test -f tv/build.gradle.kts
          test -f shared/core/build.gradle.kts
          grep -Fq 'include(":mobile")' settings.gradle.kts
          grep -Fq 'include(":tv")' settings.gradle.kts
          grep -Fq 'include(":shared:core")' settings.gradle.kts

      - name: Set up JDK 17
        uses: actions/setup-java@v5
        with:
          distribution: temurin
          java-version: ${{ env.JAVA_VERSION }}

      - name: Set up Android SDK
        uses: android-actions/setup-android@v4
        with:
          packages: >-
            platform-tools
            platforms;android-${{ env.ANDROID_API }}
            build-tools;${{ env.ANDROID_BUILD_TOOLS }}
          log-accepted-android-sdk-licenses: "false"

      - name: Set up Gradle
        uses: gradle/actions/setup-gradle@v6
        with:
          gradle-version: ${{ env.GRADLE_VERSION }}

      - name: Final Mobile + TV + Shared build
        shell: bash
        run: |
          set -euo pipefail
          gradle             :shared:core:assembleDebug             :mobile:assembleDebug             :tv:assembleDebug             --stacktrace             --no-daemon

      - name: Verify final package IDs
        shell: bash
        run: |
          set -euo pipefail

          MOBILE_APK="mobile/build/outputs/apk/debug/mobile-debug.apk"
          TV_APK="tv/build/outputs/apk/debug/tv-debug.apk"
          AAPT="$ANDROID_SDK_ROOT/build-tools/${ANDROID_BUILD_TOOLS}/aapt"

          test -s "$MOBILE_APK"
          test -s "$TV_APK"

          MOBILE_PACKAGE="$($AAPT dump badging "$MOBILE_APK" | sed -n "s/^package: name='\([^']*\)'.*/\1/p" | head -n 1)"
          TV_PACKAGE="$($AAPT dump badging "$TV_APK" | sed -n "s/^package: name='\([^']*\)'.*/\1/p" | head -n 1)"

          test "$MOBILE_PACKAGE" = "com.vueo.app"
          test "$TV_PACKAGE" = "com.vueo.tv"

          echo "Mobile: $MOBILE_PACKAGE"
          echo "TV: $TV_PACKAGE"

      - name: Commit cleanup
        shell: bash
        run: |
          set -euo pipefail

          if git diff --quiet; then
            echo "No cleanup changes to commit."
            exit 0
          fi

          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"

          git add -A
          git commit -m "chore: remove stray root source tree"
          git push origin HEAD:main
            
